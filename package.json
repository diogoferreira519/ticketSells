{
  "name": "ticketsells",
  "version": "1.0.0",
  "private": true,
  "description": "Monolithic ticket selling app with NestJS, React, Prisma and JWT auth",
  "scripts": {
    "build": "npm run build:client && nest build",
    "build:client": "npm run build --prefix client",
    "build:api": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "dev:api": "nest start --watch",
    "dev:client": "npm run dev --prefix client",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "docker:up": "docker compose up postgres rabbitmq -d",
    "docker:prod": "docker compose --profile prod up --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@prisma/client": "^6.3.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
