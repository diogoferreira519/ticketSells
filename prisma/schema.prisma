generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PagamentoStatus {
  PENDENTE
  PAGO
  CANCELADO
  FALHOU
}

enum IngressoStatus {
  VALIDO
  USADO
  CANCELADO
}

model Usuario {
  id         String  @id @default(cuid())
  nome       String
  email      String  @unique
  senha      String
  isOrg      Boolean @default(false) @map("is_org")
  isCliente  Boolean @default(true) @map("is_cliente")
  isPortaria Boolean @default(false) @map("is_portaria")

  pedidos Pedido[]
  eventos Evento[]
  salas   Sala[]

  @@map("usuarios")
}

model Sala {
  id                String @id @default(cuid())
  idUserOrganizador String @map("id_user_organizador")
  capacidade        Int
  descricao         String

  organizador Usuario   @relation(fields: [idUserOrganizador], references: [id])
  eventos     Evento[]
  assentos    Assento[]

  @@map("salas")
}

model Pedido {
  id              String          @id @default(cuid())
  idUser          String          @map("id_user")
  total           Decimal         @db.Decimal(10, 2)
  pagamentoStatus PagamentoStatus @default(PENDENTE) @map("pagamento_status")
  criadoEm        DateTime        @default(now()) @map("criado_em")

  usuario   Usuario    @relation(fields: [idUser], references: [id])
  ingressos Ingresso[]

  @@map("pedidos")
}

model Assento {
  id        String @id @default(cuid())
  idSala    String @map("id_sala")
  descricao String
  fila      Int
  coluna    Int

  sala      Sala       @relation(fields: [idSala], references: [id])
  ingressos Ingresso[]

  @@map("assentos")
}

model Ingresso {
  id        String         @id @default(cuid())
  idPedido  String         @map("id_pedido")
  idAssento String         @map("id_assento")
  idEvento  String         @map("id_evento")
  qrcode    String         @unique
  status    IngressoStatus @default(VALIDO)
  link      String
  usadoEm   DateTime?      @map("usado_em")

  pedido  Pedido  @relation(fields: [idPedido], references: [id])
  assento Assento @relation(fields: [idAssento], references: [id])
  evento  Evento  @relation(fields: [idEvento], references: [id])

  @@unique([idEvento, idAssento])
  @@map("ingressos")
}

model Evento {
  id                String   @id @default(cuid())
  idFilme           String   @map("id_filme")
  idUserOrganizador String   @map("id_user_organizador")
  idSala            String   @map("id_sala")
  titulo            String
  descricao         String
  imgFilme          String   @map("img_filme")
  data              DateTime
  preco             Decimal  @db.Decimal(10, 2)
  criadoEm          DateTime @default(now()) @map("criado_em")

  organizador Usuario    @relation(fields: [idUserOrganizador], references: [id])
  sala        Sala       @relation(fields: [idSala], references: [id])
  ingressos   Ingresso[]

  @@map("eventos")
}
